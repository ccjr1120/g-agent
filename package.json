{
  "name": "g-agent",
  "private": true,
  "version": "0.1.0",
  "description": "A simple terminal agent monorepo",
  "packageManager": "pnpm@9.15.9",
  "scripts": {
    "build": "pnpm --filter @g-agent/tui exec tsc --noEmit",
    "dev": "bash scripts/dev.sh",
    "dev:server": "pnpm --filter @g-agent/server dev",
    "dev:tui": "pnpm --filter @g-agent/tui dev",
    "start": "pnpm --filter @g-agent/tui start",
    "test": "pnpm test:agent && pnpm test:server && pnpm test:tui",
    "test:agent": "pnpm --filter @g-agent/agent test",
    "test:server": "pnpm --filter @g-agent/server test",
    "test:tui": "pnpm --filter @g-agent/tui test"
  },
  "engines": {
    "node": ">=18"
  }
}
